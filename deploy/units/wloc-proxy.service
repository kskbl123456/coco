[Unit]
Description=WLoc - 定位代理（TLS 中间人 + AppleWLoc 坐标改写）
Documentation=file:/opt/wloc-web/生产部署文档.md
After=network-online.target wloc-loopback-ip.service
Wants=network-online.target
Requires=wloc-loopback-ip.service

[Service]
Type=simple
# 需要 root：要绑 10.10.1.1:443 特权端口，且要读 /etc/ipsec.d/private/ 里的私钥
User=root
WorkingDirectory=/opt/wloc-web
EnvironmentFile=-/etc/wloc-web/env
# ★ 2026-10-09 对齐 astrace：代理只监听 8888；443 让给 nginx（PAC / Web）
#   DNS 直连（裸 TLS 443）路径已废弃，与 astrace 一致只保留 PAC 一条链路。
ExecStart=/opt/wloc-web/venv/bin/python3 /opt/wloc-web/wloc_proxy.py 8888
Restart=always
RestartSec=3
LimitNOFILE=524288

[Install]
WantedBy=multi-user.target
