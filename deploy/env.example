# WLoc 环境变量 —— 国内 PoC 部署（117.72.208.23）
#
# 由 wloc-proxy / wloc-dns / wloc-web / wloc-vpn-sync 四个服务共用
# （systemd 的 EnvironmentFile）。
#
# ★ 这里每一项都与首尔生产环境不同，改之前先看清楚注释。

# ── 隧道与路由 ──
# VPN 下发的 IP 池（与 /etc/ipsec.conf 的 rightsourceip 必须一致）
WLOC_TUNNEL_CIDR=10.20.0.0/24
# 第二个池：国内 PoC 没有，留空 → 描述文件里不写这条路由
WLOC_TUNNEL_CIDR_2=

# ── 隧道内的代理 / DNS 地址 ──
# 设备连它做 TLS 中间人；由 wloc-loopback-ip 挂到 lo 上。
# 刻意用 10.10.1.1（而不是 10.20.0.1），避免与 strongSwan 的 IP 池冲突。
WLOC_PROXY_ADDR=10.10.1.1

# ── IKEv2 服务端身份 ──
# ★ 必须与 /etc/ipsec.conf 的 leftid 一致，否则手机 IKE_AUTH 会失败
#   （日志：`no matching peer config found` + `N(AUTH_FAILED)`）
# 2026-10-02 起用域名（换 IP 客户端零改动）
WLOC_REMOTE_ID=ios.niubi6666.kdns.fr

# ── 证书 ──
# 要内嵌进描述文件、并让手机「完全信任」的根证书
WLOC_CA_CERT=/etc/ipsec.d/cacerts/wloc-cn-poc-ca-cert.pem
# 代理做中间人用的服务器证书（CN/SAN 必须是 gs-loc.apple.com）
WLOC_PROXY_CERT=/etc/ipsec.d/certs/AppWLocProxy.pem
WLOC_PROXY_KEY=/etc/ipsec.d/private/AppWLocProxy.key

# ── VPN 地址（写进描述文件的 RemoteAddress）──
# ★ 用域名：换服务器 IP 时只改 DNS，客户端零改动。
WLOC_VPN_ADDRESS=ios.niubi6666.kdns.fr

# ── DNS ──
# ★ 上游必须是国内可达的解析器。首尔生产用 8.8.8.8，国内不通。
WLOC_DNS_HOST=10.10.1.1
WLOC_DNS_REDIRECT=10.10.1.1
WLOC_DNS_UPSTREAM=223.5.5.5

# ── 路径 ──
WLOC_DB_PATH=/opt/wloc-web/wloc.db
WLOC_PROXY_LOG=/var/log/wloc-proxy.log
WLOC_DNS_LOG=/var/log/wloc-dns.log
WLOC_SYNC_LOG=/var/log/wloc-vpn-sync.log
WLOC_SECRETS_FILE=/etc/ipsec.d/wloc-users.secrets

# ── 隧道内 API（2026-10-02）──
# 敏感接口（设点/状态/地图 Key）只允许从 VPN 隧道内访问：
# 设备必须先连上 VPN 才能操作，「能连上隧道」本身就是身份证明。
WLOC_VPN_POOL=10.20.0.0/24
WLOC_TUNNEL_ORIGIN=https://10.10.1.1:8443
# CORS 白名单：页面所在的公网 origin（跨源访问隧道接口时要回 CORS 头）
WLOC_CORS_ORIGINS=https://117.72.208.23

# ── 高德（Key 由服务端下发，不写在前端）──
WLOC_AMAP_CONFIG=/etc/wloc-web/amap.json
WLOC_AMAP_STATE=/etc/wloc-web/amap-state.json

# ── 品牌信息（平台名/Logo/公告，后台可改）──
WLOC_BRAND_CONFIG=/etc/wloc-web/brand.json
